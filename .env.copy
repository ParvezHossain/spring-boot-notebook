# =============================================================================
# .env.example — Environment Variables Reference
# =============================================================================
# USAGE:
#   cp .env.example .env          # create your local .env
#   cp .env.example .env.staging  # create staging env
#   cp .env.example .env.prod     # create prod env (store in secrets manager!)
#
# RULES:
#   1. NEVER commit .env to Git — add it to .gitignore immediately
#   2. Commit ONLY .env.example (this file) with placeholder/safe defaults
#   3. In production: use AWS Secrets Manager, HashiCorp Vault, or GCP Secret Manager
#   4. In CI/CD: inject secrets via GitHub Actions Secrets / GitLab CI Variables
#   5. Rotate ALL credentials that were ever committed to Git history
#
# .gitignore entries needed:
#   .env
#   .env.*
#   !.env.example
# =============================================================================


# =============================================================================
# SPRING / APP CORE
# =============================================================================
APP_NAME=my-service
APP_VERSION=1.0.0
APP_REGION=local

# Profiles: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
MANAGEMENT_PORT=8081
SERVER_SECURE_COOKIE=false           # true in prod (HTTPS)


# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================
DB_URL=jdbc:postgresql://localhost:5432/myapp
DB_USERNAME=postgres
DB_PASSWORD=changeme_local

# Connection pool
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Read replica (optional — uncomment if using AbstractRoutingDataSource)
# DB_REPLICA_URL=jdbc:postgresql://replica-host:5432/myapp
# DB_REPLICA_USERNAME=readonly
# DB_REPLICA_PASSWORD=changeme_replica


# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                      # leave empty for no-auth (dev only)


# =============================================================================
# RABBITMQ
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_CONCURRENCY=5
RABBITMQ_MAX_CONCURRENCY=20


# =============================================================================
# MAIL — SMTP
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Gmail App Password (not account password)
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=My App Team
MAIL_REPLY_TO=support@example.com


# =============================================================================
# JWT
# =============================================================================
# Generate a secure secret:
#   openssl rand -base64 64
#   OR: keytool -genseckey -keyalg HmacSHA512 -keysize 512 -keystore jwt.jks
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRY_MS=3600000               # 1 hour
JWT_REFRESH_EXPIRY_MS=604800000     # 7 days
APP_JWT_AUDIENCE=my-service-clients


# =============================================================================
# OAUTH2 — Google
# =============================================================================
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret


# =============================================================================
# OAUTH2 — GitHub
# =============================================================================
# GitHub → Settings → Developer settings → OAuth Apps
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


# =============================================================================
# OAUTH2 — Microsoft Entra ID / Azure AD (uncomment if used)
# =============================================================================
# Azure Portal → App registrations
# https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# AZURE_CLIENT_ID=your-azure-app-client-id
# AZURE_CLIENT_SECRET=your-azure-app-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id


# =============================================================================
# FRONTEND / BACKEND BASE URLS
# =============================================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# OAuth2 redirects
OAUTH2_SUCCESS_REDIRECT=http://localhost:3000/oauth2/success
OAUTH2_FAILURE_REDIRECT=http://localhost:3000/oauth2/failure


# =============================================================================
# ACTUATOR / OBSERVABILITY
# =============================================================================
# Comma-separated list of endpoints to expose
ACTUATOR_ENDPOINTS=health,info,metrics,prometheus,loggers,env,flyway,threaddump,caches

# health show-details: never | when-authorized | always
ACTUATOR_HEALTH_DETAILS=when-authorized

# env show-values: never | when-authorized | always
ACTUATOR_ENV_SHOW_VALUES=never

# Enable heapdump only when debugging (large file, security risk)
ACTUATOR_HEAPDUMP_ENABLED=false


# =============================================================================
# DISTRIBUTED TRACING
# =============================================================================
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# Sampling rate: 0.0 = none, 0.1 = 10%, 1.0 = 100%
# Use 1.0 in dev, 0.1 in prod (tune based on traffic volume)
TRACING_SAMPLE_RATE=1.0


# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMITER_ENABLED=true
RATE_LIMITER_TYPE=memory            # memory (dev) | redis (prod)
RATE_LIMITER_MAX=100
RATE_LIMITER_WINDOW=60              # seconds


# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL_APP=DEBUG                 # DEBUG (dev) | INFO (staging) | WARN (prod)
LOG_LEVEL_SQL=WARN                  # set to DEBUG to print SQL statements
LOG_FILE_PATH=logs


# =============================================================================
# SWAGGER / OPENAPI
# =============================================================================
SWAGGER_ENABLED=true                # false in prod
SWAGGER_TRY_IT_OUT=true             # false in prod


# =============================================================================
# TOMCAT
# =============================================================================
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_THREADS=20


# =============================================================================
# ASYNC TASK POOLS
# =============================================================================
TASK_POOL_CORE=10
TASK_POOL_MAX=50


# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_TYPE=local                  # local | s3 | gcs
STORAGE_LOCAL_PATH=/tmp/uploads

# AWS S3 (used when STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id          # prefer IAM roles — avoid key-based auth
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=my-app-uploads-bucket


# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Payment Service
PAYMENT_SERVICE_URL=http://localhost:8090
PAYMENT_SERVICE_API_KEY=CHANGE_ME_payment_api_key

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8091

# Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:8092


# =============================================================================
# SECURITY — BCRYPT
# =============================================================================
# Cost factor: 10 = dev/staging (~100ms), 12 = prod (~400ms)
# Never go below 10. Each increment doubles the time.
BCRYPT_STRENGTH=10


# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_EMAIL_VERIFY=false          # false in dev for easy testing
FEATURE_OAUTH2_SIGNUP=true
FEATURE_MAINTENANCE=false
FEATURE_NEW_DASHBOARD=false


# =============================================================================
# SCHEDULED JOBS
# =============================================================================
CLEANUP_INTERVAL_MS=3600000         # 1 hour


# =============================================================================
# NOTIFICATIONS — Slack / PagerDuty
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ALERT_CHANNEL=#alerts
PAGERDUTY_KEY=your-pagerduty-integration-key


# =============================================================================
# KAFKA (uncomment if using Kafka)
# =============================================================================
# KAFKA_BROKERS=localhost:9092
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_LISTENER_CONCURRENCY=3
# For SASL_SSL (prod):
# KAFKA_USERNAME=your-kafka-username
# KAFKA_PASSWORD=your-kafka-password
# KAFKA_SCHEMA_REGISTRY=http://localhost:8081


# =============================================================================
# MICROSOFT AZURE / AWS / GCP (uncomment per cloud)
# =============================================================================

# --- AWS ---
# AWS_ACCESS_KEY_ID=                # Use IAM roles in EC2/ECS/EKS — avoid static keys
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=my-bucket

# --- GCP ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=my-gcp-project
# GCP_STORAGE_BUCKET=my-gcs-bucket

# --- Azure ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=my-container


# =============================================================================
# HASHICORP VAULT (prod secret injection — reference only)
# =============================================================================
# In prod, Vault injects secrets at startup via spring-cloud-vault:
# spring.cloud.vault:
#   host: vault.internal
#   port: 8200
#   scheme: https
#   authentication: aws-iam   # or kubernetes, token, approle
#   kv.enabled: true
#   kv.backend: secret
#   kv.default-context: ${spring.application.name}
#
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=your-vault-token         # only for dev; use AWS IAM / k8s auth in prod


# =============================================================================
# KUBERNETES / DOCKER (reference — set these in your deployment manifests)
# =============================================================================
# These are typically NOT in .env — they come from k8s ConfigMaps/Secrets.
# Listed here as documentation of what Kubernetes must inject.
#
# JVM flags (set in Deployment spec.containers.env):
#   JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
#                     -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError
#                     -XX:HeapDumpPath=/tmp/heap.hprof
#                     -XX:+ExitOnOutOfMemoryError
#                     -Djava.security.egd=file:/dev/./urandom
#
# Health probe paths (used in k8s livenessProbe/readinessProbe):
#   liveness:  GET /actuator/health/liveness  (port: MANAGEMENT_PORT)
#   readiness: GET /actuator/health/readiness (port: MANAGEMENT_PORT)


# =============================================================================
# QUICK-GENERATE CHEATSHEET
# =============================================================================
# JWT Secret (256-bit base64):
#   openssl rand -base64 64
#
# Random password (32 chars):
#   openssl rand -base64 32
#
# UUID:
#   python3 -c "import uuid; print(uuid.uuid4())"
#
# BCrypt hash (to verify BCRYPT_STRENGTH):
#   htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
#
# Check which env vars are missing from a running Spring Boot app:
#   curl -s http://localhost:8081/actuator/env | jq '.propertySources[] | select(.name | contains("systemEnvironment")) | .properties | keys'
# =============================================================================